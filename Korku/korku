    def draw_background(self):
        if self.dark_mode:
            background_color = BGCOLOR
            wall_color = WALL_COLOR
            wall_inner_color = WALL_INNER
            floor_color = FLOOR_COLOR
        else:
            background_color = LIGHT_BACKGROUND
            wall_color = LIGHT_WALL_COLOR
            wall_inner_color = LIGHT_WALL_INNER
            floor_color = LIGHT_FLOOR_COLOR

        self.screen.fill(background_color)

        for y, row in enumerate(self.maze):
            for x, cell in enumerate(row):
                rect = pygame.Rect(x * TILE, y * TILE, TILE, TILE)
                if cell == "#":
                    pygame.draw.rect(self.screen, wall_color, rect)
                    pygame.draw.rect(self.screen, wall_inner_color, rect.inflate(-8, -8))
                else:
                    pygame.draw.rect(self.screen, floor_color, rect)

        door_color = DOOR_GLOW if self.key_count >= self.required_keys else LOCKED_DOOR_COLOR
        pygame.draw.rect(self.screen, door_color, self.exit_rect)
        pygame.draw.rect(self.screen, (20, 20, 20), self.exit_rect.inflate(-10, -10), 2)

        for key in self.keys:
            if self.dark_mode:
                dx = key.centerx - self.player.centerx
                dy = key.centery - self.player.centery
                if dx * dx + dy * dy > self.vision_radius * self.vision_radius:
                    continue
            self.draw_key_icon(key.center)

        if not self.practice_mode:
            for enemy in self.enemies:
                self.draw_enemy(enemy)

        self.draw_player()

        if self.flash > 0:
            pulse = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
            pulse.fill((255, 255, 255, int(80 * self.flash / 0.25)))
            self.screen.blit(pulse, (0, 0))

        if self.red_alert > 0:
            danger_overlay = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
            alpha = int(90 * self.red_alert)
            danger_overlay.fill((180, 20, 30, alpha))
            self.screen.blit(danger_overlay, (0, 0))

