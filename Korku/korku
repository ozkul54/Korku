class Game:
    def __init__(self):
        pygame.init()
        pygame.display.set_caption("Korku - Karanlık Kaçış")
        self.screen = pygame.display.set_mode((WIDTH, HEIGHT))
        self.clock = pygame.time.Clock()
        self.font = pygame.font.SysFont(FONT_NAME, 28)
        self.small_font = pygame.font.SysFont(FONT_NAME, 20)
        self.title_font = pygame.font.SysFont(FONT_NAME, 54, bold=True)

        self.running = True
        self.state = "menu"
        self.settings_return_state = "menu"
        self.platform = "PC"
        self.difficulty = "Normal"
        self.graphics_quality = "Yüksek"
        self.dark_mode = True
        self.practice_mode = False
        self.vision_radius = 180
        self.mobile_controls = {"up": False, "down": False, "left": False, "right": False, "sprint": False}
        self.control_button_rects = {}
        self.sprint_button_rect = pygame.Rect(0, 0, 90, 90)
        self.setup_mobile_controls()
        self.fog_opacity = MAX_FOG_OPACITY
        self.dragging_vision = False
        self.dragging_opacity = False
        self.required_keys = 3
        self.message_timer = 0
        self.flash = 0.0
        self.red_alert = 0.0
        self.score = 0
        self.paused = False
        self.best_score = self.load_best_score()
        self.reset_game()

    def load_best_score(self):
        try:
            if HIGHSCORE_FILE.exists():
                with HIGHSCORE_FILE.open("r", encoding="utf-8") as file:
                    data = json.load(file)
                    if isinstance(data, dict):
                        return int(data.get("best_score", 0))
        except (OSError, ValueError, json.JSONDecodeError):
            pass
        return 0

    def save_best_score(self):
        try:
            with HIGHSCORE_FILE.open("w", encoding="utf-8") as file:
                json.dump({"best_score": self.best_score}, file, ensure_ascii=False)
        except OSError:
            pass

    def set_difficulty(self, difficulty):
        if difficulty in DIFFICULTY_SETTINGS:
            self.difficulty = difficulty
            self.time_left = DIFFICULTY_SETTINGS[difficulty]["time"]
            if self.state == "menu":
                self.reset_game()

    def reset_game(self):
        self.level_number = 1
        self.score = 0
        self.coins = 0
        self.player_speed = 150
        self.next_level_bonus_time = 0
        self.paused = False
        self.load_level()

    def find_open_tile_near(self, pixel_x, pixel_y):
        start_tile_x = int(pixel_x // TILE)
        start_tile_y = int(pixel_y // TILE)
        max_radius = max(len(self.maze[0]), len(self.maze))

        for radius in range(0, max_radius + 1):
            for offset_y in range(-radius, radius + 1):
                for offset_x in range(-radius, radius + 1):
                    tile_x = start_tile_x + offset_x
                    tile_y = start_tile_y + offset_y
                    if not (0 <= tile_y < len(self.maze) and 0 <= tile_x < len(self.maze[tile_y])):
                        continue
                    if self.maze[tile_y][tile_x] == "#":
                        continue
                    return (
                        tile_x * TILE + TILE // 2 - 11,
                        tile_y * TILE + TILE // 2 - 11,
                    )

        return (pixel_x, pixel_y)

    def load_level(self):
        level = LEVELS[self.level_number - 1]
        self.maze = level["maze"]
        self.open_narrow_wall_blockers()
        if self.level_number == 2:
            self.open_second_level_blocker()
        self.walls = []
        self.keys = []
        self.key_count = 0
        self.message_timer = 0
        self.flash = 0.0
        self.red_alert = 0.0
        self.stamina = MAX_STAMINA
        self.time_left = DIFFICULTY_SETTINGS[self.difficulty]["time"] + self.next_level_bonus_time
        self.next_level_bonus_time = 0

        player_start = self.find_open_tile_near(*level["player_start"])
        exit_pos = self.find_open_tile_near(*level["exit_pos"])
        self.player = pygame.Rect(player_start[0], player_start[1], 22, 22)
        self.exit_rect = pygame.Rect(exit_pos[0], exit_pos[1], TILE, TILE)

        if self.practice_mode:
            self.enemies = []
        else:
            enemy_count = DIFFICULTY_SETTINGS[self.difficulty]["enemy_count"]
            enemy_spawns = level["enemies"][:enemy_count]
            enemy_speeds = (60, 72, 82, 68)
            enemy_types = ["octopus", "turtle", "lobster"]
            self.enemies = []
            for i, ((x, y), speed) in enumerate(zip(enemy_spawns, enemy_speeds[:enemy_count])):
                kind = enemy_types[i % len(enemy_types)]
                self.enemies.append(
                    {
                        "rect": pygame.Rect(x * TILE + 8, y * TILE + 8, 20, 20),
                        "speed": speed * (1 + (self.level_number - 1) * 0.2),
                        "kind": kind,
                        "patrol_center": pygame.Vector2(x * TILE + TILE // 2, y * TILE + TILE // 2),
                        "patrol_angle": (i * 1.4) % (math.pi * 2),
                        "idle_timer": i * 0.7,
                    }
                )

        for y, row in enumerate(self.maze):
            for x, cell in enumerate(row):
                if cell == "#":
                    self.walls.append(pygame.Rect(x * TILE, y * TILE, TILE, TILE))

        self.required_keys = DIFFICULTY_SETTINGS[self.difficulty]["required_keys"]
        self.create_keys()

    def open_narrow_wall_blockers(self):
        """Oyuncunun sıkışmasına neden olan dar duvar boşluklarını açar."""
        blockers = {
            1: ((8, 3), (7, 3), (8, 4), (7, 4), (10, 7), (11, 7), (10, 8), (11, 8)),
            2: ((9, 9), (10, 9), (11, 9), (10, 8), (11, 8), (10, 10), (11, 10)),
            3: ((8, 3), (9, 3), (8, 4), (9, 4), (10, 8), (11, 8), (10, 9), (11, 9)),
        }

        for x, y in blockers.get(self.level_number, ()):
            if 0 <= y < len(self.maze) and 0 <= x < len(self.maze[y]):
                row = list(self.maze[y])
                if row[x] == "#":
                    row[x] = "."
                    self.maze[y] = "".join(row)

    def open_second_level_blocker(self):
        """İkinci bölümde düşmanların yolu tıkayan kritik duvarı açar."""
        if len(self.maze) > 9:
            row = list(self.maze[9])
            if len(row) > 10 and row[10] == "#":
                row[10] = "."
                self.maze[9] = "".join(row)

    def create_keys(self):
        start = (self.player.centerx // TILE, self.player.centery // TILE)
        reachable = {start}
        frontier = [start]

        while frontier:
            x, y = frontier.pop()
            for next_x, next_y in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
                if (
                    0 <= next_y < len(self.maze)
                    and 0 <= next_x < len(self.maze[next_y])
                    and self.maze[next_y][next_x] != "#"
                    and (next_x, next_y) not in reachable
                ):
                    reachable.add((next_x, next_y))
                    frontier.append((next_x, next_y))

        excluded = {
            start,
            (self.exit_rect.centerx // TILE, self.exit_rect.centery // TILE),
            *((enemy["rect"].centerx // TILE, enemy["rect"].centery // TILE) for enemy in self.enemies),
        }
        candidates = [
            pygame.Rect(x * TILE + TILE // 2 - 10, y * TILE + TILE // 2 - 10, 20, 20)
            for x, y in reachable
            if (x, y) not in excluded
        ]
        key_count = min(self.required_keys, len(candidates))
        self.keys = random.sample(candidates, key_count)

    def collides_with_obstacle(self, rect):
        if self.collides_with_wall(rect):
            return True
        return False

    def collides_with_wall(self, rect):
        return any(rect.colliderect(wall) for wall in self.walls)

    def setup_mobile_controls(self):
        base_x = 30
        base_y = HEIGHT - 172
        self.control_button_rects = {
            "up": pygame.Rect(base_x + 60, base_y, 56, 56),
            "left": pygame.Rect(base_x, base_y + 60, 56, 56),
            "down": pygame.Rect(base_x + 60, base_y + 120, 56, 56),
            "right": pygame.Rect(base_x + 120, base_y + 60, 56, 56),
        }
        self.sprint_button_rect = pygame.Rect(WIDTH - 120, HEIGHT - 120, 90, 90)

    def handle_mobile_touch(self, pos, pressed):
        for key, rect in self.control_button_rects.items():
            if rect.collidepoint(pos):
                self.mobile_controls[key] = pressed
        if self.sprint_button_rect.collidepoint(pos):
            self.mobile_controls["sprint"] = pressed

    def start_game(self):
        self.state = "playing"
        self.reset_game()

    def collect_keys(self):
        for key in self.keys[:]:
            if self.player.colliderect(key):
                self.keys.remove(key)
                self.key_count += 1
                self.score += 100
                self.coins += 1
                self.message_timer = 1.2
                self.flash = 0.25

                if self.best_score < self.score:
                    self.best_score = self.score
                    self.save_best_score()

    def handle_events(self):
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                self.running = False
                return

            if event.type == pygame.MOUSEBUTTONUP:
                if self.state == "playing" and self.platform == "Mobil":
                    for key in self.mobile_controls:
                        self.mobile_controls[key] = False
                self.dragging_vision = False
                self.dragging_opacity = False
                continue

            if event.type == pygame.MOUSEMOTION and (self.dragging_vision or self.dragging_opacity):
                if self.dragging_vision:
                    self.set_vision_radius(event.pos[0])
                if self.dragging_opacity:
                    self.set_fog_opacity(event.pos[0])
                continue

            if event.type == pygame.MOUSEBUTTONDOWN and event.button == 1:
                if self.state == "playing" and self.platform == "Mobil":
                    self.handle_mobile_touch(event.pos, True)
                    continue
                if self.state == "menu" and hasattr(self, "start_button_rect") and self.start_button_rect.collidepoint(event.pos):
                    self.start_game()
                    continue
                if self.state == "menu" and hasattr(self, "settings_button_rect") and self.settings_button_rect.collidepoint(event.pos):
                    self.settings_return_state = "menu"
                    self.state = "settings"
                    continue
                if self.state == "menu":
                    for mode, rect in self.menu_platform_buttons:
                        if rect.collidepoint(event.pos):
                            self.platform = mode
                            break
                if self.state == "settings":
                    if hasattr(self, "settings_resume_rect") and self.settings_resume_rect.collidepoint(event.pos):
                        self.state = self.settings_return_state if self.settings_return_state in ("playing", "paused", "menu") else "menu"
                        if self.state == "playing":
                            self.paused = False
                        self.dragging_vision = False
                        self.dragging_opacity = False
                        continue
                    if hasattr(self, "settings_menu_rect") and self.settings_menu_rect.collidepoint(event.pos):
                        self.state = "menu"
                        self.dragging_vision = False
                        self.dragging_opacity = False
                        continue
                    if hasattr(self, "settings_exit_rect") and self.settings_exit_rect.collidepoint(event.pos):
                        self.running = False
                        continue
                    if hasattr(self, "practice_toggle_rect") and self.practice_toggle_rect.collidepoint(event.pos):
                        self.practice_mode = not self.practice_mode
                        self.reset_game() if self.state == "menu" else self.load_level()
                        continue
                    for mode, rect in self.settings_mode_buttons:
                        if rect.collidepoint(event.pos):
                            self.dark_mode = mode == "KARANLIK"
                            break
                    for quality, rect in self.graphics_quality_buttons:
                        if rect.collidepoint(event.pos):
                            self.graphics_quality = quality
                            break
                    for difficulty, rect in self.settings_difficulty_buttons:
                        if rect.collidepoint(event.pos):
                            self.set_difficulty(difficulty)
                            break
                    for platform, rect in self.settings_platform_buttons:
                        if rect.collidepoint(event.pos):
                            self.platform = platform
                            break
                    if self.vision_slider_rect.collidepoint(event.pos):
                        self.dragging_vision = True
                        self.set_vision_radius(event.pos[0])
                    if self.dark_mode and self.fog_opacity_slider_rect.collidepoint(event.pos):
                        self.dragging_opacity = True
                        self.set_fog_opacity(event.pos[0])
                    continue
                if self.state == "shop":
                    if self.shop_continue_rect.collidepoint(event.pos):
                        self.advance_to_next_level()
                        continue
                    for item_id, rect in self.shop_item_buttons:
                        if rect.collidepoint(event.pos):
                            self.purchase_shop_item(item_id)
                            break
                    continue
                if self.state in ("win", "lose") and hasattr(self, "end_button_rect") and self.end_button_rect.collidepoint(event.pos):
                    self.state = "menu"
                    continue

            if event.type != pygame.KEYDOWN:
                continue

            if self.state == "menu" and event.key in (pygame.K_RETURN, pygame.K_SPACE):
                self.start_game()
                continue

            if self.state == "settings" and event.key == pygame.K_ESCAPE:
                self.state = self.settings_return_state if self.settings_return_state in ("playing", "paused", "menu") else "menu"
                if self.state == "playing":
                    self.paused = False
                self.dragging_vision = False
                self.dragging_opacity = False
                continue

            if self.state == "playing" and event.key == pygame.K_ESCAPE:
                self.settings_return_state = "playing"
                self.state = "settings"
                self.paused = True
                self.dragging_vision = False
                self.dragging_opacity = False
                continue

            if self.state == "paused" and event.key == pygame.K_ESCAPE:
                self.settings_return_state = "paused"
                self.state = "settings"
                self.dragging_vision = False
                self.dragging_opacity = False
                continue

            if self.state == "shop" and event.key in (pygame.K_RETURN, pygame.K_SPACE):
                self.advance_to_next_level()
                continue

            if self.state == "paused" and event.key in (pygame.K_p, pygame.K_ESCAPE):
                self.paused = False
                self.state = "playing"
                continue

            if self.state in ("win", "lose") and event.key in (pygame.K_RETURN, pygame.K_SPACE, pygame.K_r):
                self.state = "menu"
                continue

            if event.key == pygame.K_ESCAPE:
                self.running = False
                continue

            if event.key == pygame.K_p and self.state == "playing":
                self.paused = True
                self.state = "paused"
                continue

            if event.key == pygame.K_1:
                self.set_difficulty("Kolay")
            elif event.key == pygame.K_2:
                self.set_difficulty("Normal")
            elif event.key == pygame.K_3:
                self.set_difficulty("Zor")

    def set_vision_radius(self, mouse_x):
        slider = self.vision_slider_rect
        ratio = max(0.0, min(1.0, (mouse_x - slider.left) / slider.width))
        radius = MIN_VISION_RADIUS + ratio * (MAX_VISION_RADIUS - MIN_VISION_RADIUS)
        self.vision_radius = round(radius / 10) * 10

    def set_fog_opacity(self, mouse_x):
        slider = self.fog_opacity_slider_rect
        ratio = max(0.0, min(1.0, (mouse_x - slider.left) / slider.width))
        opacity = MIN_FOG_OPACITY + ratio * (MAX_FOG_OPACITY - MIN_FOG_OPACITY)
        self.fog_opacity = max(MIN_FOG_OPACITY, min(MAX_FOG_OPACITY, round(opacity / 5) * 5))

    def purchase_shop_item(self, item_id):
        item = next((item for item in SHOP_ITEMS if item["id"] == item_id), None)
        if item is None:
            return

        if self.coins < item["cost"]:
            self.shop_message = "Yeterli jetonun yok."
            return

        if item_id == "lantern" and self.vision_radius >= MAX_VISION_RADIUS:
            self.shop_message = "Fenerin gücü zaten en yüksek seviyede."
            return
        if item_id == "boots" and self.player_speed >= 230:
            self.shop_message = "Koşu botları en yüksek seviyede."
            return

        self.coins -= item["cost"]
        if item_id == "lantern":
            self.vision_radius = min(MAX_VISION_RADIUS, self.vision_radius + 40)
            self.shop_message = "Fener güçlendirildi."
        elif item_id == "boots":
            self.player_speed = min(230, self.player_speed + 20)
            self.shop_message = "Hareket hızın arttı."
        else:
            self.next_level_bonus_time += 20
            self.shop_message = "Sonraki bölüme 20 saniye eklendi."

    def advance_to_next_level(self):
        self.level_number += 1
        self.load_level()
        self.state = "playing"

    def move_player(self, dt):
        dx = 0
        dy = 0
        keys = pygame.key.get_pressed()

        if self.platform == "PC":
            if keys[pygame.K_w] or keys[pygame.K_UP]:
                dy -= 1
            if keys[pygame.K_s] or keys[pygame.K_DOWN]:
                dy += 1
            if keys[pygame.K_a] or keys[pygame.K_LEFT]:
                dx -= 1
            if keys[pygame.K_d] or keys[pygame.K_RIGHT]:
                dx += 1
        else:
            if self.mobile_controls["up"]:
                dy -= 1
            if self.mobile_controls["down"]:
                dy += 1
            if self.mobile_controls["left"]:
                dx -= 1
            if self.mobile_controls["right"]:
                dx += 1

        if dx != 0 or dy != 0:
            length = math.hypot(dx, dy)
            dx /= length
            dy /= length

        moving = dx != 0 or dy != 0
        sprinting = moving and (
            (self.platform == "PC" and (keys[pygame.K_LSHIFT] or keys[pygame.K_RSHIFT]))
            or (self.platform == "Mobil" and self.mobile_controls["sprint"])
        ) and self.stamina > 0
        if sprinting:
            speed = self.player_speed * 1.7
            self.stamina = max(0, self.stamina - 38 * dt)
        else:
            speed = self.player_speed
            self.stamina = min(MAX_STAMINA, self.stamina + 24 * dt)

        next_x = self.player.move(dx * speed * dt, 0)
        if not self.collides_with_obstacle(next_x):
            self.player.x = next_x.x

        next_y = self.player.move(0, dy * speed * dt)
        if not self.collides_with_obstacle(next_y):
            self.player.y = next_y.y

        self.player.x = max(0, min(self.player.x, WIDTH - self.player.width))
        self.player.y = max(0, min(self.player.y, HEIGHT - self.player.height))

    def find_enemy_path(self, start, target):
        start_tile = (start[0] // TILE, start[1] // TILE)
        target_tile = (target[0] // TILE, target[1] // TILE)
        frontier = deque([start_tile])
        previous = {start_tile: None}

        while frontier:
            x, y = frontier.popleft()
            if (x, y) == target_tile:
                break

            for next_tile in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
                next_x, next_y = next_tile
                if (
                    0 <= next_y < len(self.maze)
                    and 0 <= next_x < len(self.maze[next_y])
                    and self.maze[next_y][next_x] != "#"
                    and next_tile not in previous
                ):
                    previous[next_tile] = (x, y)
                    frontier.append(next_tile)

        if target_tile not in previous:
            return []

        path = []
        tile = target_tile
        while previous[tile] is not None:
            path.append(tile)
            tile = previous[tile]
        path.reverse()
        return path

    def move_enemies(self, dt):
        if self.practice_mode:
            return
        difficulty = DIFFICULTY_SETTINGS[self.difficulty]
        for enemy in self.enemies:
            target = pygame.Vector2(self.player.centerx, self.player.centery)
            current = pygame.Vector2(enemy["rect"].centerx, enemy["rect"].centery)
            distance = target - current
            danger = distance.length() < difficulty["danger"]

            if danger:
                self.red_alert = min(1.0, self.red_alert + dt * 3.5)
            else:
                self.red_alert = max(0.0, self.red_alert - dt * 2.0)

            kind = enemy.get("kind", "octopus")
            if distance.length() < difficulty["awareness"]:
                if distance.length() > 0:
                    if kind == "octopus":
                        chase_speed = enemy["speed"] * (difficulty["chase_boost"] if danger else 1.05)
                        path = self.find_enemy_path(
                            (enemy["rect"].centerx, enemy["rect"].centery),
                            (self.player.centerx, self.player.centery),
                        )
                        waypoint = target
                        if path:
                            tile_x, tile_y = path[0]
                            waypoint = pygame.Vector2(tile_x * TILE + TILE // 2, tile_y * TILE + TILE // 2)
                        drift = pygame.Vector2(math.cos(enemy["patrol_angle"]), math.sin(enemy["patrol_angle"])) * 18
                        direction = (waypoint - current) + drift
                        if direction.length() > 0:
                            speed = chase_speed * difficulty["enemy_speed"]
                            step = direction.normalize() * min(speed * dt, direction.length())
                            next_x = enemy["rect"].move(step.x, 0)
                            if not self.collides_with_obstacle(next_x):
                                enemy["rect"].x = next_x.x
                            next_y = enemy["rect"].move(0, step.y)
                            if not self.collides_with_obstacle(next_y):
                                enemy["rect"].y = next_y.y
                            enemy["patrol_angle"] += dt * 1.8

                    elif kind == "turtle":
                        chase_speed = enemy["speed"] * (difficulty["chase_boost"] * 0.8 if danger else 0.7)
                        direction = target - current
                        if direction.length() > 0:
                            speed = chase_speed * difficulty["enemy_speed"]
                            step = direction.normalize() * min(speed * dt, direction.length())
                            next_x = enemy["rect"].move(step.x * 0.75, 0)
                            if not self.collides_with_obstacle(next_x):
                                enemy["rect"].x = next_x.x
                            next_y = enemy["rect"].move(0, step.y * 0.75)
                            if not self.collides_with_obstacle(next_y):
                                enemy["rect"].y = next_y.y
                            enemy["patrol_angle"] += dt * 0.7

                    elif kind == "lobster":
                        chase_speed = enemy["speed"] * (difficulty["chase_boost"] * 1.4 if danger else 1.2)
                        direction = target - current
                        if direction.length() > 0:
                            speed = chase_speed * difficulty["enemy_speed"]
                            dash_rush = 1.2 if danger else 0.8
                            step = direction.normalize() * min(speed * dash_rush * dt, direction.length())
                            next_x = enemy["rect"].move(step.x, 0)
                            if not self.collides_with_obstacle(next_x):
                                enemy["rect"].x = next_x.x
                            next_y = enemy["rect"].move(0, step.y)
                            if not self.collides_with_obstacle(next_y):
                                enemy["rect"].y = next_y.y

            else:
                if kind == "octopus":
                    enemy["idle_timer"] += dt
                    orbit = pygame.Vector2(
                        math.cos(enemy["patrol_angle"]) * 28,
                        math.sin(enemy["patrol_angle"] * 1.5) * 22,
                    )
                    target_pos = enemy["patrol_center"] + orbit
                    move_dir = target_pos - current
                    if move_dir.length() > 0:
                        step = move_dir.normalize() * min(28 * dt, move_dir.length())
                        next_x = enemy["rect"].move(step.x, 0)
                        if not self.collides_with_obstacle(next_x):
                            enemy["rect"].x = next_x.x
                        next_y = enemy["rect"].move(0, step.y)
                        if not self.collides_with_obstacle(next_y):
                            enemy["rect"].y = next_y.y
                    enemy["patrol_angle"] += dt * 0.9

                elif kind == "turtle":
                    enemy["idle_timer"] += dt
                    patrol_offset = pygame.Vector2(
                        math.cos(enemy["patrol_angle"]) * 52,
                        math.sin(enemy["patrol_angle"]) * 52,
                    )
                    patrol_target = enemy["patrol_center"] + patrol_offset
                    move_dir = patrol_target - current
                    if move_dir.length() > 0:
                        step = move_dir.normalize() * min(22 * dt, move_dir.length())
                        next_x = enemy["rect"].move(step.x, 0)
                        if not self.collides_with_obstacle(next_x):
                            enemy["rect"].x = next_x.x
                        next_y = enemy["rect"].move(0, step.y)
                        if not self.collides_with_obstacle(next_y):
                            enemy["rect"].y = next_y.y
                    enemy["patrol_angle"] += dt * 0.6

                elif kind == "lobster":
                    enemy["idle_timer"] += dt
                    side_step = pygame.Vector2(
                        math.cos(enemy["patrol_angle"]) * 30,
                        math.sin(enemy["patrol_angle"]) * 30,
                    )
                    move_dir = side_step
                    if move_dir.length() > 0:
                        step = move_dir.normalize() * min(36 * dt, move_dir.length())
                        next_x = enemy["rect"].move(step.x, 0)
                        if not self.collides_with_obstacle(next_x):
                            enemy["rect"].x = next_x.x
                        next_y = enemy["rect"].move(0, step.y)
                        if not self.collides_with_obstacle(next_y):
                            enemy["rect"].y = next_y.y
                    enemy["patrol_angle"] += dt * 1.3

            if self.player.colliderect(enemy["rect"]):
                self.state = "lose"

    def update(self, dt):
        if self.state != "playing":
            return

        self.time_left -= dt
        if self.graphics_quality != "Düşük" and self.flash > 0:
            self.flash = max(0.0, self.flash - dt)
        if self.graphics_quality != "Düşük" and self.red_alert > 0:
            self.red_alert = max(0.0, self.red_alert - dt * 0.8)

        if self.time_left <= 0:
            self.state = "lose"
            self._save_score_if_needed()
            return

        self.move_player(dt)
        self.collect_keys()
        self.move_enemies(dt)

        if self.key_count >= self.required_keys and self.player.colliderect(self.exit_rect):
            self.score += max(0, int(self.time_left * 10))
            self._save_score_if_needed()
            if self.level_number < len(LEVELS):
                self.coins += 2
                self.shop_message = "Bölüm ödülü: 2 jeton"
                self.state = "shop"
            else:
                self.state = "win"

    def _save_score_if_needed(self):
        if self.score > self.best_score:
            self.best_score = self.score
            self.save_best_score()

