    def draw_mobile_controls(self):
        if self.platform != "Mobil":
            return

        for name, rect in self.control_button_rects.items():
            pressed = self.mobile_controls.get(name, False)
            color = ACCENT if pressed else (30, 40, 48)
            pygame.draw.rect(self.screen, color, rect, border_radius=12)
            pygame.draw.rect(self.screen, (255, 255, 255, 120), rect, 2, border_radius=12)

            center = rect.center
            if name == "up":
                points = [(center[0], rect.top + 12), (rect.right - 10, rect.bottom - 12), (rect.left + 10, rect.bottom - 12)]
            elif name == "down":
                points = [(center[0], rect.bottom - 12), (rect.right - 10, rect.top + 12), (rect.left + 10, rect.top + 12)]
            elif name == "left":
                points = [(rect.left + 12, center[1]), (rect.right - 12, rect.top + 10), (rect.right - 12, rect.bottom - 10)]
            else:
                points = [(rect.right - 12, center[1]), (rect.left + 12, rect.top + 10), (rect.left + 12, rect.bottom - 10)]
            pygame.draw.polygon(self.screen, TEXT_COLOR, points)

        sprint_pressed = self.mobile_controls.get("sprint", False)
        sprint_color = ACCENT if sprint_pressed else (30, 40, 48)
        pygame.draw.rect(self.screen, sprint_color, self.sprint_button_rect, border_radius=18)
        pygame.draw.rect(self.screen, (255, 255, 255, 120), self.sprint_button_rect, 2, border_radius=18)
        sprint_label = self.small_font.render("RUN", True, TEXT_COLOR)
        self.screen.blit(sprint_label, (self.sprint_button_rect.centerx - sprint_label.get_width() // 2, self.sprint_button_rect.centery - sprint_label.get_height() // 2))

    def run(self):
        while self.running:
            dt = self.clock.tick(FPS) / 1000.0
            self.handle_events()
            if self.state == "playing":
                self.update(dt)

            if self.state == "menu":
                self.draw_menu()
            elif self.state == "settings":
                self.draw_settings()
            elif self.state == "shop":
                self.draw_shop()
            elif self.state == "playing":
                self.draw_background()
                if self.dark_mode:
                    self.draw_fog()
                self.draw_hud()
                self.draw_mobile_controls()
            elif self.state == "paused":
                self.draw_background()
                if self.dark_mode:
                    self.draw_fog()
                self.draw_hud()
                self.draw_mobile_controls()
                self.draw_pause_overlay()
            elif self.state == "win":
                self.draw_background()
                if self.dark_mode:
                    self.draw_fog()
                self.draw_hud()
                self.draw_end_screen("KAÇTIN!", "Tüm bölümlerden kurtuldun.", show_thanks=True)
            elif self.state == "lose":
                self.draw_background()
                if self.dark_mode:
                    self.draw_fog()
                self.draw_hud()
                self.draw_end_screen("YAKALANDIN", "Düşman seni yakaladı.", show_thanks=False)

            pygame.display.flip()

        pygame.quit()
        return


